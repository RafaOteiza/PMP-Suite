@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #1565C0
skinparam shadowing false
package "PMP Suite" {
  [Autenticación y RBAC]
  [Activos]
  [Casos y OS]
  [Terreno]
  [Bodega / Logística]
  [Laboratorio]
  [QA]
  [Bridge / Referencias]
  [Repuestos y Stock]
  [Trazabilidad]
  [Supervisión]
  [IA / Analítica]
  [Centro de reportes Excel]
  [Cuenta Mobile]
}
[Autenticación y RBAC] --> [Terreno]
[Autenticación y RBAC] --> [Bodega / Logística]
[Autenticación y RBAC] --> [Laboratorio]
[Autenticación y RBAC] --> [QA]
[Activos] --> [Casos y OS]
[Casos y OS] --> [Terreno]
[Casos y OS] --> [Bodega / Logística]
[Casos y OS] --> [Laboratorio]
[Casos y OS] --> [QA]
[Casos y OS] --> [Bridge / Referencias]
[Laboratorio] --> [Repuestos y Stock]
[Terreno] --> [Trazabilidad]
[Bodega / Logística] --> [Trazabilidad]
[Laboratorio] --> [Trazabilidad]
[QA] --> [Trazabilidad]
[Trazabilidad] --> [Supervisión]
[Trazabilidad] --> [IA / Analítica]
[Supervisión] --> [Centro de reportes Excel]
[IA / Analítica] --> [Centro de reportes Excel]
[Autenticación y RBAC] --> [Centro de reportes Excel]
[Autenticación y RBAC] --> [Cuenta Mobile]
@enduml
