}
entity solicitud_items {
 * id
 --
 solicitud_id
 repuesto_id
 cantidad
}
entity repuestos {
 * id
 --
 nombre
 categoria
 stock
 stock_critico
}
entity bridge_referencias {
 * id
 --
 tipo_equipo
 serie
 codigo_os
 sistema_externo
 referencia_externa
