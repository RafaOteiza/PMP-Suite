 id="Definitions_ASIS_V2" targetNamespace="https://pmp-suite.local/bpmn">
 <bpmn:collaboration id="Collaboration_ASIS">
  <bpmn:participant id="Participant_ASIS" name="Proceso de mantenimiento AS-IS" processRef="Process_ASIS_V2"/>
 </bpmn:collaboration>
 <bpmn:process id="Process_ASIS_V2" name="PMP Suite AS-IS — proceso fragmentado" isExecutable="false">
  <bpmn:laneSet id="LaneSet_ASIS_V2">
   <bpmn:lane id="Lane_Bodega" name="Bodega / Mersan"><bpmn:flowNodeRef>Start_ASIS</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Preparar</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Guia</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_GuiaOK</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Urgencia</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Enviar</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_RecibirBodega</bpmn:flowNodeRef><bpmn:flowNodeRef>End_ASIS</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Jefatura" name="Jefatura Laboratorio"><bpmn:flowNodeRef>AS_Recibir</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Antecedentes</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Solicitar</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Conciliar</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Registrar</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Asignar</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Despacho</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Tecnico" name="Técnico Laboratorio"><bpmn:flowNodeRef>AS_Diagnostico</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_DiagGate</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_EsperarRep</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Reparar</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_DocPoD</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Probar</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Solucion</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_QA" name="QA"><bpmn:flowNodeRef>AS_QA</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_QAGate</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Rechazo</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Analistas" name="Analistas / Cliente"><bpmn:flowNodeRef>AS_EnviarAnte</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_PoD" name="Gestión PoD"><bpmn:flowNodeRef>AS_InformePoD</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_PlanillaPoD</bpmn:flowNodeRef></bpmn:lane>
  </bpmn:laneSet>
  <bpmn:startEvent id="Start_ASIS" name="Equipo retirado / lote preparado"/>
  <bpmn:task id="AS_Preparar" name="Preparar lote y antecedentes"/>
  <bpmn:exclusiveGateway id="AS_Guia" name="¿Guía disponible?"/>
  <bpmn:task id="AS_GuiaOK" name="Preparar guía"/>
  <bpmn:task id="AS_Urgencia" name="Informar urgencia / series por correo"/>
  <bpmn:task id="AS_Enviar" name="Enviar equipo a Laboratorio"/>
  <bpmn:task id="AS_Recibir" name="Recibir equipo físico"/>
  <bpmn:exclusiveGateway id="AS_Antecedentes" name="¿Antecedentes suficientes?"/>
  <bpmn:task id="AS_Solicitar" name="Solicitar / buscar antecedentes"/>
  <bpmn:task id="AS_EnviarAnte" name="Enviar series / antecedentes"/>
  <bpmn:task id="AS_Conciliar" name="Conciliar guía, tarjetón, correo y planillas"/>
  <bpmn:task id="AS_Registrar" name="Registrar ingreso en control interno"/>
  <bpmn:task id="AS_Asignar" name="Asignar trabajo"/>
  <bpmn:task id="AS_Diagnostico" name="Diagnosticar equipo"/>
  <bpmn:exclusiveGateway id="AS_DiagGate" name="Resultado diagnóstico"/>
  <bpmn:task id="AS_EsperarRep" name="Coordinar / esperar repuesto"/>
  <bpmn:task id="AS_Reparar" name="Reparar"/>
  <bpmn:task id="AS_DocPoD" name="Documentar PoD"/>
  <bpmn:task id="AS_InformePoD" name="Emitir informe técnico PoD"/>
  <bpmn:task id="AS_PlanillaPoD" name="Actualizar planilla / seguimiento PoD"/>
  <bpmn:task id="AS_Probar" name="Ejecutar pruebas"/>
  <bpmn:task id="AS_Solucion" name="Registrar / informar solución"/>
  <bpmn:task id="AS_Despacho" name="Preparar despacho por lote"/>
  <bpmn:task id="AS_QA" name="Ejecutar control QA"/>
  <bpmn:exclusiveGateway id="AS_QAGate" name="¿Aprobado?"/>
  <bpmn:task id="AS_Rechazo" name="Informar rechazo / reingreso"/>
  <bpmn:task id="AS_RecibirBodega" name="Recibir equipo aprobado"/>
  <bpmn:endEvent id="End_ASIS" name="Equipo devuelto / estado conciliado"/>
  <bpmn:sequenceFlow id="A1" sourceRef="Start_ASIS" targetRef="AS_Preparar"/>
  <bpmn:sequenceFlow id="A2" sourceRef="AS_Preparar" targetRef="AS_Guia"/>
  <bpmn:sequenceFlow id="A3" name="Sí" sourceRef="AS_Guia" targetRef="AS_GuiaOK"/>
  <bpmn:sequenceFlow id="A4" name="No / urgencia" sourceRef="AS_Guia" targetRef="AS_Urgencia"/>
  <bpmn:sequenceFlow id="A5" sourceRef="AS_GuiaOK" targetRef="AS_Enviar"/>
  <bpmn:sequenceFlow id="A6" sourceRef="AS_Urgencia" targetRef="AS_Enviar"/>
  <bpmn:sequenceFlow id="A7" sourceRef="AS_Enviar" targetRef="AS_Recibir"/>
  <bpmn:sequenceFlow id="A8" sourceRef="AS_Recibir" targetRef="AS_Antecedentes"/>
  <bpmn:sequenceFlow id="A9" name="Sí" sourceRef="AS_Antecedentes" targetRef="AS_Conciliar"/>
  <bpmn:sequenceFlow id="A10" name="No / incompletos" sourceRef="AS_Antecedentes" targetRef="AS_Solicitar"/>
  <bpmn:sequenceFlow id="A11" sourceRef="AS_Solicitar" targetRef="AS_EnviarAnte"/>
  <bpmn:sequenceFlow id="A12" sourceRef="AS_EnviarAnte" targetRef="AS_Conciliar"/>
  <bpmn:sequenceFlow id="A13" sourceRef="AS_Conciliar" targetRef="AS_Registrar"/>
  <bpmn:sequenceFlow id="A14" sourceRef="AS_Registrar" targetRef="AS_Asignar"/>
  <bpmn:sequenceFlow id="A15" sourceRef="AS_Asignar" targetRef="AS_Diagnostico"/>
  <bpmn:sequenceFlow id="A16" sourceRef="AS_Diagnostico" targetRef="AS_DiagGate"/>
  <bpmn:sequenceFlow id="A17" name="Reparable / falla diferente" sourceRef="AS_DiagGate" targetRef="AS_Reparar"/>
  <bpmn:sequenceFlow id="A18" name="Requiere repuesto" sourceRef="AS_DiagGate" targetRef="AS_EsperarRep"/>
  <bpmn:sequenceFlow id="A19" sourceRef="AS_EsperarRep" targetRef="AS_Reparar"/>
  <bpmn:sequenceFlow id="A20" name="PoD" sourceRef="AS_DiagGate" targetRef="AS_DocPoD"/>
  <bpmn:sequenceFlow id="A21" sourceRef="AS_DocPoD" targetRef="AS_InformePoD"/>
  <bpmn:sequenceFlow id="A22" sourceRef="AS_InformePoD" targetRef="AS_PlanillaPoD"/>
  <bpmn:sequenceFlow id="A23" sourceRef="AS_PlanillaPoD" targetRef="AS_Probar"/>
  <bpmn:sequenceFlow id="A24" name="NFF" sourceRef="AS_DiagGate" targetRef="AS_Probar"/>
  <bpmn:sequenceFlow id="A25" sourceRef="AS_Reparar" targetRef="AS_Probar"/>
  <bpmn:sequenceFlow id="A26" sourceRef="AS_Probar" targetRef="AS_Solucion"/>
  <bpmn:sequenceFlow id="A27" sourceRef="AS_Solucion" targetRef="AS_Despacho"/>
  <bpmn:sequenceFlow id="A28" sourceRef="AS_Despacho" targetRef="AS_QA"/>
  <bpmn:sequenceFlow id="A29" sourceRef="AS_QA" targetRef="AS_QAGate"/>
  <bpmn:sequenceFlow id="A30" name="Aprobado" sourceRef="AS_QAGate" targetRef="AS_RecibirBodega"/>
  <bpmn:sequenceFlow id="A31" sourceRef="AS_RecibirBodega" targetRef="End_ASIS"/>
  <bpmn:sequenceFlow id="A32" name="Rechazado" sourceRef="AS_QAGate" targetRef="AS_Rechazo"/>
  <bpmn:sequenceFlow id="A33" sourceRef="AS_Rechazo" targetRef="AS_Conciliar"/>
 </bpmn:process>
