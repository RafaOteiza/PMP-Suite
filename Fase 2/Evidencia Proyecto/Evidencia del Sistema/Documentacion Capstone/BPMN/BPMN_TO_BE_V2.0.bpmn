<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_TOBE_V2" targetNamespace="https://pmp-suite.local/bpmn">
  <bpmn:collaboration id="Collaboration_TOBE">
    <bpmn:participant id="Participant_TOBE" name="Proceso integrado PMP Suite TO-BE" processRef="Process_TOBE_V2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TOBE_V2" name="PMP Suite TO-BE — Physical First" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TOBE_V2">
      <bpmn:lane id="Lane_Terreno" name="Técnico Terreno">
        <bpmn:flowNodeRef>Start_TOBE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_Reportar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_ValidRetiro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_ConfRetiro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_Instalar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_InstGate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistica" name="Logística / Bodega">
        <bpmn:flowNodeRef>TO_RecTerreno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_SalLab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_EntregarRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_RecLabBod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_SalQA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_RecQABod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_DespTerr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_AsignarRetiro</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_JefeLab" name="Jefe Laboratorio">
        <bpmn:flowNodeRef>TO_RecLab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_Asignar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_SalidaLab</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TecLab" name="Técnico Laboratorio">
        <bpmn:flowNodeRef>TO_Diagnostico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_RepGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_SolRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_Reparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_Pruebas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_TestGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_Cerrar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QA" name="QA">
        <bpmn:flowNodeRef>TO_RecQA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_Ambiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_QAPruebas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_Dictamen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_SalidaQA</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Sistema PMP Suite">
        <bpmn:flowNodeRef>TO_CasoOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_EventoRetiro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_CustBod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_CicloLab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_SLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_CrearSol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_Stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_Listo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_CicloQA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_Elegible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_CrearIN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_Operacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_Reingreso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_QAGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TO_InstFallida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Retorno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TOBE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_TOBE" name="Falla detectada / requerimiento" />
    <bpmn:task id="TO_Reportar" name="Reportar falla" />
    <bpmn:serviceTask id="TO_CasoOS" name="Crear caso y OS" />
    <bpmn:task id="TO_ValidRetiro" name="Validar identidad del retiro" />
    <bpmn:task id="TO_ConfRetiro" name="Confirmar retiro físico" />
    <bpmn:serviceTask id="TO_EventoRetiro" name="Registrar retiro y tránsito" />
    <bpmn:task id="TO_RecTerreno" name="Validar y confirmar recepción" />
    <bpmn:serviceTask id="TO_CustBod" name="Registrar custodia Bodega" />
    <bpmn:task id="TO_SalLab" name="Validar y confirmar salida Lab" />
    <bpmn:serviceTask id="TO_CicloLab" name="Abrir ciclo Laboratorio" />
    <bpmn:task id="TO_RecLab" name="Confirmar recepción Lab" />
    <bpmn:serviceTask id="TO_SLA" name="Iniciar SLA del ciclo" />
    <bpmn:task id="TO_Asignar" name="Asignar técnico" />
    <bpmn:task id="TO_Diagnostico" name="Diagnosticar" />
    <bpmn:exclusiveGateway id="TO_RepGate" name="¿Requiere repuesto?" />
    <bpmn:task id="TO_SolRep" name="Solicitar necesidad de repuesto" />
    <bpmn:serviceTask id="TO_CrearSol" name="Crear solicitud / espera" />
    <bpmn:task id="TO_EntregarRep" name="Entregar repuesto" />
    <bpmn:serviceTask id="TO_Stock" name="Descontar stock y auditar" />
    <bpmn:task id="TO_Reparar" name="Intervenciones / reparación" />
    <bpmn:task id="TO_Pruebas" name="Manual / Test MK" />
    <bpmn:exclusiveGateway id="TO_TestGate" name="¿Pruebas aprobadas?" />
    <bpmn:task id="TO_Cerrar" name="Finalizar trabajo técnico" />
    <bpmn:serviceTask id="TO_Listo" name="Registrar listo para salida" />
    <bpmn:task id="TO_SalidaLab" name="Validar y confirmar salida Lab" />
    <bpmn:task id="TO_RecLabBod" name="Confirmar recepción Bodega" />
    <bpmn:task id="TO_SalQA" name="Validar y confirmar salida QA" />
    <bpmn:serviceTask id="TO_CicloQA" name="Abrir ciclo QA" />
    <bpmn:task id="TO_RecQA" name="Confirmar recepción QA" />
    <bpmn:task id="TO_Ambiente" name="Instalación Ambiente" />
    <bpmn:task id="TO_QAPruebas" name="Pruebas QA" />
    <bpmn:task id="TO_Dictamen" name="Registrar dictamen" />
    <bpmn:exclusiveGateway id="TO_QAGate" name="¿Operativo?" />
    <bpmn:task id="TO_SalidaQA" name="Validar y confirmar salida QA" />
    <bpmn:task id="TO_RecQABod" name="Confirmar recepción Bodega" />
    <bpmn:serviceTask id="TO_Elegible" name="Evaluar elegibilidad de stock" />
    <bpmn:task id="TO_DespTerr" name="Validar y confirmar despacho Terreno" />
    <bpmn:serviceTask id="TO_CrearIN" name="Crear IN + SALIDA_BODEGA_TERRENO" />
    <bpmn:task id="TO_Instalar" name="Confirmar resultado de instalación" />
    <bpmn:serviceTask id="TO_Operacion" name="Registrar activo en operación" />
    <bpmn:endEvent id="End_TOBE" name="Activo en operación" />
    <bpmn:serviceTask id="TO_Reingreso" name="Preparar reingreso a Laboratorio" />
    <bpmn:sequenceFlow id="T1" sourceRef="Start_TOBE" targetRef="TO_Reportar" />
    <bpmn:sequenceFlow id="T2" sourceRef="TO_Reportar" targetRef="TO_CasoOS" />
    <bpmn:sequenceFlow id="T3" sourceRef="TO_CasoOS" targetRef="TO_AsignarRetiro" />
    <bpmn:sequenceFlow id="T4" sourceRef="TO_ValidRetiro" targetRef="TO_ConfRetiro" />
    <bpmn:sequenceFlow id="T5" sourceRef="TO_ConfRetiro" targetRef="TO_EventoRetiro" />
    <bpmn:sequenceFlow id="T6" sourceRef="TO_EventoRetiro" targetRef="TO_RecTerreno" />
    <bpmn:sequenceFlow id="T7" sourceRef="TO_RecTerreno" targetRef="TO_CustBod" />
    <bpmn:sequenceFlow id="T8" sourceRef="TO_CustBod" targetRef="TO_SalLab" />
    <bpmn:sequenceFlow id="T9" sourceRef="TO_SalLab" targetRef="TO_CicloLab" />
    <bpmn:sequenceFlow id="T10" sourceRef="TO_CicloLab" targetRef="TO_RecLab" />
    <bpmn:sequenceFlow id="T11" sourceRef="TO_RecLab" targetRef="TO_SLA" />
    <bpmn:sequenceFlow id="T12" sourceRef="TO_SLA" targetRef="TO_Asignar" />
    <bpmn:sequenceFlow id="T13" sourceRef="TO_Asignar" targetRef="TO_Diagnostico" />
    <bpmn:sequenceFlow id="T14" sourceRef="TO_Diagnostico" targetRef="TO_RepGate" />
    <bpmn:sequenceFlow id="T15" name="No" sourceRef="TO_RepGate" targetRef="TO_Reparar" />
    <bpmn:sequenceFlow id="T16" name="Sí" sourceRef="TO_RepGate" targetRef="TO_SolRep" />
    <bpmn:sequenceFlow id="T17" sourceRef="TO_SolRep" targetRef="TO_CrearSol" />
    <bpmn:sequenceFlow id="T18" sourceRef="TO_CrearSol" targetRef="TO_EntregarRep" />
    <bpmn:sequenceFlow id="T19" sourceRef="TO_EntregarRep" targetRef="TO_Stock" />
    <bpmn:sequenceFlow id="T20" sourceRef="TO_Stock" targetRef="TO_Reparar" />
    <bpmn:sequenceFlow id="T21" sourceRef="TO_Reparar" targetRef="TO_Pruebas" />
    <bpmn:sequenceFlow id="T22" sourceRef="TO_Pruebas" targetRef="TO_TestGate" />
    <bpmn:sequenceFlow id="T23" name="Sí" sourceRef="TO_TestGate" targetRef="TO_Cerrar" />
    <bpmn:sequenceFlow id="T24" name="No / corregir" sourceRef="TO_TestGate" targetRef="TO_Reparar" />
    <bpmn:sequenceFlow id="T25" sourceRef="TO_Cerrar" targetRef="TO_Listo" />
    <bpmn:sequenceFlow id="T26" sourceRef="TO_Listo" targetRef="TO_SalidaLab" />
    <bpmn:sequenceFlow id="T27" sourceRef="TO_SalidaLab" targetRef="TO_RecLabBod" />
    <bpmn:sequenceFlow id="T28" sourceRef="TO_RecLabBod" targetRef="TO_SalQA" />
    <bpmn:sequenceFlow id="T29" sourceRef="TO_SalQA" targetRef="TO_CicloQA" />
    <bpmn:sequenceFlow id="T30" sourceRef="TO_CicloQA" targetRef="TO_RecQA" />
    <bpmn:sequenceFlow id="T31" sourceRef="TO_RecQA" targetRef="TO_Ambiente" />
    <bpmn:sequenceFlow id="T32" sourceRef="TO_Ambiente" targetRef="TO_QAPruebas" />
    <bpmn:sequenceFlow id="T33" sourceRef="TO_QAPruebas" targetRef="TO_Dictamen" />
    <bpmn:sequenceFlow id="T34" sourceRef="TO_Dictamen" targetRef="TO_SalidaQA" />
    <bpmn:sequenceFlow id="T35" name="Operativo" sourceRef="TO_QAGate" targetRef="TO_Elegible" />
    <bpmn:sequenceFlow id="T36" sourceRef="TO_SalidaQA" targetRef="TO_RecQABod" />
    <bpmn:sequenceFlow id="T37" sourceRef="TO_RecQABod" targetRef="TO_QAGate" />
    <bpmn:sequenceFlow id="T38" sourceRef="TO_Elegible" targetRef="TO_DespTerr" />
    <bpmn:sequenceFlow id="T39" sourceRef="TO_DespTerr" targetRef="TO_CrearIN" />
    <bpmn:sequenceFlow id="T40" sourceRef="TO_CrearIN" targetRef="TO_Instalar" />
    <bpmn:sequenceFlow id="T41" sourceRef="TO_Instalar" targetRef="TO_InstGate" />
    <bpmn:sequenceFlow id="T42" sourceRef="TO_Operacion" targetRef="End_TOBE" />
    <bpmn:sequenceFlow id="T43" name="Rechazado" sourceRef="TO_QAGate" targetRef="TO_Reingreso" />
    <bpmn:sequenceFlow id="T44" name="Nuevo ciclo vía Bodega" sourceRef="TO_Reingreso" targetRef="TO_SalLab" />
    <bpmn:task id="TO_AsignarRetiro" name="Asignar retiro a técnico Terreno" />
    <bpmn:sequenceFlow id="T45" sourceRef="TO_AsignarRetiro" targetRef="TO_ValidRetiro" />
    <bpmn:exclusiveGateway id="TO_InstGate" name="¿Instalado OK?" />
    <bpmn:serviceTask id="TO_InstFallida" name="Registrar instalación fallida; estado 11" />
    <bpmn:endEvent id="End_Retorno" name="Retorno a Bodega pendiente" />
    <bpmn:sequenceFlow id="T46" sourceRef="TO_InstGate" targetRef="TO_Operacion" name="Sí" />
    <bpmn:sequenceFlow id="T47" sourceRef="TO_InstGate" targetRef="TO_InstFallida" name="No" />
    <bpmn:sequenceFlow id="T48" sourceRef="TO_InstFallida" targetRef="End_Retorno" />
  </bpmn:process>
